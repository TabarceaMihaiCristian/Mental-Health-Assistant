{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "outDir": "./.tsbuild/node",
    "tsBuildInfoFile": "./.tsbuild/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "eslint.config.js",
    "playwright.config.ts",
    "tests/e2e/**/*.ts"
  ]
}
