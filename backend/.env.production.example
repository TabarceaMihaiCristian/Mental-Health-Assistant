# Production deployment example.
# Replace every placeholder before deploying.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/mental_health_app
SECRET_KEY=replace_with_a_real_long_random_secret_key
BACKEND_CORS_ORIGINS=["https://your-frontend-domain.example"]
OPENAI_API_KEY=replace_with_real_openai_key
OPENAI_MODEL=gpt-5-mini
AUTO_MIGRATE=true
SCHEDULER_ENABLED=true
SCHEDULER_RUN_IN_DEBUG=false
DEBUG=false
ENVIRONMENT=production
