# Local development example.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/mental_health_app
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mental_health_app_test
SECRET_KEY=replace_with_a_long_random_secret_key
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AUTO_MIGRATE=true
SCHEDULER_ENABLED=true
SCHEDULER_RUN_IN_DEBUG=false

# Optional deterministic demo seed credentials.
SEED_ADMIN_EMAIL=admin.test@mentalhealthapp.com
SEED_ADMIN_PASSWORD=AdminTest123!
SEED_SPECIALIST_EMAIL=specialist.test@mentalhealthapp.com
SEED_SPECIALIST_PASSWORD=SpecialistTest123!
SEED_USER_EMAIL=user.test@mentalhealthapp.com
SEED_USER_PASSWORD=UserTest123!
